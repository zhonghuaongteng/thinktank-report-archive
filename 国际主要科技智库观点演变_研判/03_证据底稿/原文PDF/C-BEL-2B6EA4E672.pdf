    xmlns:Iptc4xmpExt="http://iptc.org/std/Iptc4xmpExt/2008-02-29/"
   photoshop:Credit="AP"
   photoshop:AuthorsPosition="STF"
   photoshop:City="Tokyo"
   photoshop:CaptionWriter="SK OTA**TOK**"
   photoshop:Category="F"
   photoshop:Source="AP"
   photoshop:DateCreated="17 Nov 2014"
   photoshop:Instructions="MONDAY, NOV. 17, 2014 PHOTO"
   photoshop:TransmissionReference="XKAN206"
   photoshop:Country="JPN"
   plus:ImageSupplierImageID="98ddce77-9d5b-4393-a07e-044a72858769"
   plus:Version="1.2.0"
